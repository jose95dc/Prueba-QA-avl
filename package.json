{
  "name": "mi-proyecto-qa-automation",
  "version": "1.0.0",
  "description": "Prueba técnica QA Automation: Appium + WebdriverIO, Playwright API Testing y KafkaJS opcional.",
  "type": "module",
  "scripts": {
    "test:api": "playwright test api-tests",
    "test:mobile": "wdio run wdio.conf.ts",
    "test:kafka": "playwright test event-tests",
    "test:all": "npm run test:api && npm run test:mobile",
    "report": "playwright show-report",
    "kafka:up": "docker compose up -d",
    "kafka:down": "docker compose down -v",
    "doctor:appium": "appium driver doctor uiautomator2 || appium-doctor --android",
    "prepare:playwright": "npx playwright install"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.56.0",
    "@wdio/appium-service": "^9.20.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "appium": "^3.0.0",
    "appium-uiautomator2-driver": "^7.6.0",
    "dotenv": "^16.4.7",
    "kafkajs": "^2.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "webdriverio": "^9.20.0"
  }
}
